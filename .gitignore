# ─── Gradle ───────────────────────────────────────────────────────────────
.gradle/
build/
.kotlin/
*.probe                 # временные файлы file-watching Gradle
*.hprof                 # дампы кучи JVM

# ВАЖНО: не игнорируйте *.jar глобально — потеряете gradle-wrapper.jar.
# Если всё-таки добавите правило *.jar выше, верните wrapper jar явно:
# !gradle/wrapper/gradle-wrapper.jar

# ─── Локальная конфигурация ──────────────────────────────────────────────
local.properties        # sdk.dir и путь к SDK, у каждого свой
keystore.properties     # путь/пароли к keystore (если заведёте)
*.jks
*.keystore
*.p12

# ─── Секреты ─────────────────────────────────────────────────────────────
.env
.env.*
google-services.json

# ─── Логи и OS-мусор ─────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db

# ─── Android-артефакты сборки ────────────────────────────────────────────
captures/
.externalNativeBuild/
.cxx/
.navigation/
*.aab
*.apk
output-metadata.json

# ─── IntelliJ / Android Studio (на случай, если откроете в IDE) ─────────
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# ─── VS Code ─────────────────────────────────────────────────────────────
.vscode/
.history/               # расширение Local History

# ─── Merge-конфликты и бэкапы ────────────────────────────────────────────
*.orig
*.rej
*.bak